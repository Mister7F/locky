{
    "manifest_version": 3,
    "name": "Locky",
    "version": "1.18",
    "description": "Password manager",
    "permissions": ["activeTab", "storage", "tabs"],
    "action": {
        "default_icon": {
            "16": "icons/16.png",
            "32": "icons/32.png",
            "64": "icons/64.png"
        }
    },
    "commands": {
        "_execute_action": {
            "description": "Toggle the Locky sidebar"
        }
    },
    "background": {
        "scripts": ["background.firefox.js"]
    },
    "sidebar_action": {
        "default_title": "Locky",
        "default_panel": "popup.html",
        "default_icon": {
            "16": "icons/16.png",
            "32": "icons/32.png",
            "64": "icons/64.png"
        },
        "open_at_install": false
    },
    "icons": {
        "16": "icons/16.png",
        "32": "icons/32.png",
        "64": "icons/64.png"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ],
    "options_page": "options.html",
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "locky@example.com",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    }
}
